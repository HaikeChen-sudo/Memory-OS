# ============================================================
# Memory OS — AI Provider Configuration
# ============================================================
# Priority: DeepSeek → OpenAI → Anthropic
# The first provider with a valid API key wins.
# All others are ignored automatically.

# --- DeepSeek (default, recommended) ---
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# --- OpenAI (fallback) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Anthropic (fallback) ---
ANTHROPIC_API_KEY=

# --- Supabase (optional — only if you want cloud sync later) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
